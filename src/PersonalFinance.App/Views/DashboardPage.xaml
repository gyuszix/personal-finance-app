<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersonalFinance.App.ViewModels"
             x:Class="PersonalFinance.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             x:Name="Page"
             Title="Dashboard">

    <ScrollView>
        <!-- Full width; the cards flow into columns (see DashboardPage.LayOutCards) -->
        <VerticalStackLayout Padding="40,28,40,48" Spacing="24">

            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Dashboard"
                       Style="{StaticResource Headline}"
                       FontSize="32"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Refresh"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding LoadDashboardCommand}"
                        IsEnabled="{Binding IsNotLoading}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}" />

            <!-- First-run state: nothing linked, so every card would be empty. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoAccounts}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="No accounts linked yet" Style="{StaticResource SubHeadline}" />
                    <Label Text="Connect a bank to import your balances and transactions."
                           TextColor="{StaticResource TextMuted}" />
                    <Button Text="Connect a bank"
                            HorizontalOptions="Start"
                            Command="{Binding GoToAccountsCommand}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="20" IsVisible="{Binding HasAccounts}">

                <!-- Month: shared by every card that's per month -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Button Text="‹"
                            Style="{StaticResource IconButton}"
                            SemanticProperties.Description="Previous month"
                            Command="{Binding PreviousMonthCommand}" />
                    <Label Grid.Column="1"
                           Text="{Binding MonthLabel}"
                           Style="{StaticResource SubHeadline}"
                           FontSize="20"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="›"
                            Style="{StaticResource IconButton}"
                            SemanticProperties.Description="Next month"
                            Command="{Binding NextMonthCommand}"
                            IsEnabled="{Binding CanGoToNextMonth}" />
                </Grid>

                <!-- Tabs -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Tabs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:InsightTab">
                                <Button Text="{Binding Name}"
                                        Style="{StaticResource TabButton}"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectTabCommand, x:DataType=ContentPage}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource ToriiSoft}" />
                                            <Setter Property="TextColor" Value="{StaticResource Torii}" />
                                            <Setter Property="BorderColor" Value="{StaticResource Torii}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Cards; each one's view comes from its AddInsightCard registration.
                     Widths are set in code-behind so they form even columns. -->
                <FlexLayout x:Name="Cards"
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start"
                            AlignContent="Start"
                            BindableLayout.ItemsSource="{Binding VisibleCards}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
