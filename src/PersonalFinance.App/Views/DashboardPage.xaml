<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersonalFinance.App.ViewModels"
             x:Class="PersonalFinance.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16,20,0">
            <Label Grid.Column="0"
                   Text="Dashboard"
                   Style="{StaticResource Headline}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Refresh"
                    Command="{Binding LoadDashboardCommand}"
                    IsEnabled="{Binding IsNotLoading}" />
        </Grid>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20" Spacing="24">

                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       IsVisible="{Binding HasError}" />

                <!-- First-run state: nothing linked yet, so the figures below
                     would all read $0.00 and look like a failed load. -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding HasNoAccounts}">
                    <Label Text="No accounts linked yet"
                           Style="{StaticResource Headline}" />
                    <Label Text="Connect a bank to import your balances and transactions." />
                    <Button Text="Connect a bank"
                            HorizontalOptions="Start"
                            Command="{Binding GoToAccountsCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="24" IsVisible="{Binding HasAccounts}">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Net Worth" Style="{StaticResource Headline}" />
                        <Label Text="{Binding NetWorth, StringFormat='{0:C}'}" FontSize="32" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Total Assets" FontAttributes="Bold" />
                            <Label Text="{Binding TotalAssets, StringFormat='{0:C}'}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Total Liabilities" FontAttributes="Bold" />
                            <Label Text="{Binding TotalLiabilities, StringFormat='{0:C}'}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="This Month" Style="{StaticResource Headline}" />
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Income" FontAttributes="Bold" />
                                <Label Text="{Binding Income, StringFormat='{0:C}'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Expenses" FontAttributes="Bold" />
                                <Label Text="{Binding Expenses, StringFormat='{0:C}'}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="Net" FontAttributes="Bold" />
                                <Label Text="{Binding Net, StringFormat='{0:C}'}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
