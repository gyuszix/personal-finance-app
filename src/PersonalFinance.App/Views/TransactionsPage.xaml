<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersonalFinance.App.ViewModels"
             xmlns:dto="clr-namespace:PersonalFinance.Shared.DTOs;assembly=PersonalFinance.Shared"
             x:Class="PersonalFinance.App.Views.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="Transactions">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <Picker Grid.Row="0"
                Title="Category"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}" />

        <Label Grid.Row="1"
               Text="{Binding OfflineStatusText}"
               IsVisible="{Binding IsOffline}"
               BackgroundColor="#FFF3CD"
               TextColor="#664D03"
               Padding="10,6" />

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Transactions}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreTransactionsCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:TransactionResponse">
                    <Grid Padding="15" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding Description}" />
                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:C}'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                   IsVisible="{Binding IsLoadingMore}" />
            </CollectionView.Footer>
        </CollectionView>

    </Grid>

</ContentPage>