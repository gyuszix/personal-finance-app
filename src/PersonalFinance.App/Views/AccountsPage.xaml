<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersonalFinance.App.ViewModels"
             x:Class="PersonalFinance.App.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel"
             Title="Accounts">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="Accounts" Style="{StaticResource Headline}" />
        <Label Text="Coming soon" HorizontalOptions="Center" />

        <Button Text="Log out"
                Command="{Binding LogoutCommand}" />
    </VerticalStackLayout>

</ContentPage>
