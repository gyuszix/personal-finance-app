<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersonalFinance.App.ViewModels"
             xmlns:dto="clr-namespace:PersonalFinance.Shared.DTOs;assembly=PersonalFinance.Shared"
             x:Class="PersonalFinance.App.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel"
             Title="Accounts">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,16,20,0">
            <Label Grid.Column="0"
                   Text="Accounts"
                   Style="{StaticResource Headline}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Refresh"
                    Command="{Binding LoadAccountsCommand}"
                    IsEnabled="{Binding IsNotLoading}" />
        </Grid>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="Red"
               Padding="20,6" />

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

        <Label Grid.Row="3"
               Text="No accounts linked yet. Connect a bank to get started."
               IsVisible="{Binding IsEmpty}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               Padding="30" />

        <CollectionView Grid.Row="3"
                        IsVisible="{Binding HasAccounts}"
                        ItemsSource="{Binding Accounts}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:AccountResponse">
                    <Grid Padding="20,12" ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding BankName}" />
                            <Label Text="{Binding AccountType}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Balance, StringFormat='{0:C}'}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Padding="20" Spacing="12">
            <Button Text="Connect a bank"
                    Command="{Binding ConnectBankCommand}"
                    IsEnabled="{Binding CanConnectBank}" />

            <ActivityIndicator IsRunning="{Binding IsConnectingBank}"
                               IsVisible="{Binding IsConnectingBank}" />

            <Label Text="{Binding ConnectBankStatus}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasConnectBankStatus}" />

            <Button Text="Log out"
                    Command="{Binding LogoutCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
