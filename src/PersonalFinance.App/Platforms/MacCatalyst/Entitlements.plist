<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <!-- See https://aka.ms/maui-publish-app-store#add-entitlements for more information about adding entitlements.-->
    <dict>
        <!-- App Sandbox must be enabled to distribute a MacCatalyst app through the Mac App Store,
        but that requires a keychain-access-groups entitlement (and real code signing) for
        SecureStorage/Keychain access to work - without it, SecItemAdd fails with
        errSecMissingEntitlement. Off for local dev; turn back on + add keychain-access-groups
        before distributing. -->
        <key>com.apple.security.app-sandbox</key>
        <false/>
        <!-- When App Sandbox is enabled, this value is required to open outgoing network connections. -->
        <key>com.apple.security.network.client</key>
        <true/>
    </dict>
</plist>

