<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PersonalFinance.App.Insights.Cards.EmergencyFund"
             x:Class="PersonalFinance.App.Insights.Cards.EmergencyFund.EmergencyFundCardView"
             x:DataType="card:EmergencyFundCard"
             ControlTemplate="{StaticResource InsightCardTemplate}">

    <VerticalStackLayout Spacing="12">
        <Label Text="{Binding MonthsText}" Style="{StaticResource Figure}" TextColor="{Binding FigureColor}" />
        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />

        <!-- 0 to 6 months, ticks at the 3 and 6 month guideline -->
        <Grid RowDefinitions="Auto, Auto" RowSpacing="4">
            <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding FigureColor}" />
            <Grid Grid.Row="1" ColumnDefinitions="*, *">
                <Label Text="3 mo" Style="{StaticResource Caption}" HorizontalOptions="End" />
                <Label Grid.Column="1" Text="6 mo" Style="{StaticResource Caption}" HorizontalOptions="End" />
            </Grid>
        </Grid>
        <Label Text="3–6 months is the usual guideline." Style="{StaticResource Caption}" />
    </VerticalStackLayout>

</ContentView>
