<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PersonalFinance.App.Insights.Cards.DebtToIncome"
             x:Class="PersonalFinance.App.Insights.Cards.DebtToIncome.DebtToIncomeCardView"
             x:DataType="card:DebtToIncomeCard"
             ControlTemplate="{StaticResource InsightCardTemplate}">

    <VerticalStackLayout Spacing="12">
        <HorizontalStackLayout Spacing="10">
            <Label Text="{Binding RatioText}" Style="{StaticResource Figure}" />
            <Label Text="of take-home pay goes to loans" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,6" />
        </HorizontalStackLayout>
        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />

        <BoxView HeightRequest="1" IsVisible="{Binding HasPayments}" />
        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Payments}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="card:PaymentRow">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding Name}" />
                        <Label Grid.Column="1" Text="{Binding Amount}" TextColor="{StaticResource TextMuted}" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label Text="Measured against take-home pay, so it reads higher than a lender's DTI. Credit card payments aren't counted."
               Style="{StaticResource Caption}" />
    </VerticalStackLayout>

</ContentView>
