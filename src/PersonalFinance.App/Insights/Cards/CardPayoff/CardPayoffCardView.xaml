<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PersonalFinance.App.Insights.Cards.CardPayoff"
             x:Class="PersonalFinance.App.Insights.Cards.CardPayoff.CardPayoffCardView"
             x:DataType="card:CardPayoffCard"
             ControlTemplate="{StaticResource InsightCardTemplate}">

    <VerticalStackLayout Spacing="12">
        <HorizontalStackLayout Spacing="10">
            <Label Text="{Binding RatioText}" Style="{StaticResource Figure}" TextColor="{StaticResource Warning}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPaidInFull}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Positive}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{Binding Verdict}" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,6" />
        </HorizontalStackLayout>
        <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Warning}">
            <ProgressBar.Triggers>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding IsPaidInFull}" Value="True">
                    <Setter Property="ProgressColor" Value="{StaticResource Positive}" />
                </DataTrigger>
            </ProgressBar.Triggers>
        </ProgressBar>
        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
    </VerticalStackLayout>

</ContentView>
