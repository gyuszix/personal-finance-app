<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Theme tokens (#86). Views and charts use these keys, never hex values.
        Dark only: torii vermilion and neon blue are built to sit on black.
        Contrast against Ink is noted for each colour that carries text.
        Charts read the same keys through ChartPalette.
        Android also has Platforms/Android/Resources/values/colors.xml.
    -->

    <!-- Surfaces, darkest first -->
    <Color x:Key="Ink">#0B0C10</Color>              <!-- page background -->
    <Color x:Key="Surface">#15171D</Color>          <!-- cards -->
    <Color x:Key="SurfaceRaised">#1F222A</Color>    <!-- inputs, pressed, selected tab -->
    <Color x:Key="Hairline">#2C303A</Color>         <!-- borders, gridlines -->

    <!-- Text -->
    <Color x:Key="TextPrimary">#EEF0F3</Color>      <!-- 17.1:1 -->
    <Color x:Key="TextMuted">#8B919C</Color>        <!-- 6.2:1 -->
    <Color x:Key="TextOnAccent">#0B0C10</Color>     <!-- text on Torii/Neon fills -->

    <!-- Accents -->
    <Color x:Key="Torii">#F2542D</Color>            <!-- torii vermilion; brand, credit. 5.7:1 -->
    <Color x:Key="ToriiSoft">#F2542D33</Color>      <!-- 20% tint for fills behind Torii -->
    <Color x:Key="Neon">#1F8BFF</Color>             <!-- neon blue; data, debit. 5.8:1 -->
    <Color x:Key="NeonGlow">#5CC8FF</Color>         <!-- highlights, positive values. 10.4:1 -->
    <Color x:Key="NeonSoft">#1F8BFF33</Color>
    <Color x:Key="Orange">#FF9F1C</Color>           <!-- third series, warnings. 9.5:1 -->
    <Color x:Key="Blue">#3B5BFF</Color>             <!-- fourth series; marks only, 3.8:1 is too low for text -->

    <!-- Meaning -->
    <Color x:Key="Positive">#5CC8FF</Color>         <!-- = NeonGlow -->
    <Color x:Key="Negative">#F2542D</Color>         <!-- = Torii -->
    <Color x:Key="Warning">#FF9F1C</Color>          <!-- = Orange -->
    <Color x:Key="WarningSurface">#FF9F1C26</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}" />
    <SolidColorBrush x:Key="ToriiBrush" Color="{StaticResource Torii}" />
    <SolidColorBrush x:Key="NeonBrush" Color="{StaticResource Neon}" />
</ResourceDictionary>
