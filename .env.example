# Copy to .env (git-ignored) for `docker compose up`. Every value here is a
# local-development secret - generate your own, never reuse these elsewhere.

# Plaid sandbox keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# 32+ characters, e.g.: openssl rand -base64 48
JWT_KEY=

# Key-encryption key for stored secrets (docs/KEY_MANAGEMENT.md): scripts/new-kek.sh
ENCRYPTION_CURRENT_KEY_ID=k1
ENCRYPTION_KEY_K1=

# Password the migrate service gives the API's database role (pf_app).
DATABASE_APP_ROLE_PASSWORD=
